# Redis Cloud Configuration
# Add your Redis URL from Redis Cloud (redislabs.com)
# Format: redis://default:PASSWORD@HOST:PORT

REDIS_URL=redis://default:your_password@your-host.redislabs.com:port

# Admin Secret for protected endpoints
# Use a strong, random secret in production (32+ characters)
# This protects admin endpoints like reset-counter and get-all-keys

ADMIN_SECRET=your-super-secret-admin-key-change-this-in-production
